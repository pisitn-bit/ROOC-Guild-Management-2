# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this via your local setup or AI Studio UI secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The local or production URL where this application is hosted.
APP_URL="http://localhost:3000"

# FIREBASE_SERVICE_ACCOUNT: Firebase service account credential JSON string.
# Example: '{"type": "service_account", "project_id": "...", ...}'
# Leave empty to fall back to firebase-service-account.json file local storage.
FIREBASE_SERVICE_ACCOUNT=""

# ======================================================================
# Discord Configuration (สำหรับ Discord Interactions Endpoint / REST API)
# ======================================================================

# DISCORD_BOT_TOKEN: ดูได้จาก Discord Developer Portal > Bot > Token
# ใช้สำหรับ: ส่งข้อความ/ปุ่มเช็คอิน, ซิงค์สมาชิก, Register Slash Commands
DISCORD_BOT_TOKEN=""

# DISCORD_GUILD_ID: ไอดีเซิร์ฟเวอร์ Discord (เปิด Dev Mode แล้วคลิกขวาที่ Server > Copy ID)
# ใช้สำหรับ: Guild-level Slash Command (ใช้งานได้ทันที ไม่ต้องรอ 1 ชั่วโมง)
DISCORD_GUILD_ID=""

# DISCORD_PUBLIC_KEY: เอาไว้ Verify Signature ของ Discord Interactions Webhook
# ดูได้จาก Discord Developer Portal > General Information > Public Key
# *จำเป็น* ถ้าจะใช้ Interactions Endpoint URL บนหน้า Dev Portal
DISCORD_PUBLIC_KEY=""

# DISCORD_APPLICATION_ID: Application ID (Client ID) ของ Discord App
# ดูได้จาก Discord Developer Portal > General Information > Application ID
# ใช้สำหรับ: สร้าง Slash Command, ตอบกลับ Deferred Interaction
DISCORD_APPLICATION_ID=""
